{
  "servers": {
    "filesystem": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-filesystem",
        "/path/to/readable/root"
      ],
      "include_tools": [
        "read_file",
        "list_directory"
      ],
      "enabled": true
    },
    "remote_docs": {
      "transport": "streamable_http",
      "url": "http://127.0.0.1:9000/mcp",
      "include_tools": [
        "search",
        "fetch"
      ],
      "enabled": true
    },
    "nested_gateway": {
      "transport": "streamable_http",
      "url": "http://127.0.0.1:9010/mcp",
      "include_tools": [
        "inner__search",
        "inner__read_file"
      ],
      "enabled": false
    }
  }
}
