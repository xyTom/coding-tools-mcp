{
  "mcpServers": {
    "coding-tools": {
      "command": "uvx",
      "args": [
        "coding-tools-mcp",
        "--stdio",
        "--workspace",
        "/path/to/repo",
        "--tool-profile",
        "read-only",
        "--upstream-config",
        "/path/to/upstream.mcp-servers.json"
      ]
    }
  }
}
